# News Intelligence — project .env (deduped pipeline schedule reset)

# --- Database ---
# Widow server - local PostgreSQL (no SSH tunnel needed)
DB_HOST=192.168.93.101
DB_PORT=6432
DB_NAME=news_intel
DB_USER=newsapp
DB_PASSWORD=v4xB--yiRtQ5b1eact_l5K7jnq6mVPtw
DATABASE_URL=postgresql://newsapp:v4xB--yiRtQ5b1eact_l5K7jnq6mVPtw@192.168.93.101:6432/news_intel

# --- Data Directory ---
# Widow server - data stored in separate location from project code
NEWS_INTEL_DATA_DIR=/home/pete/Documents/news-intelligence-data/

# --- NAS ---
NAS_HOST=192.168.93.100
NAS_MOUNT_PATH=/mnt/nas
NAS_USER=Admin
NAS_PASSWORD=Pooter@STORAGE2024
NAS_SHARE=public
NAS_WORKGROUP=LAKEHOUSE

# --- Ollama ---
# Widow server - handles smaller models (8B, 12B, etc.)
# popOS (192.168.93.99) - RTX5090 handles 70B model for heavy summarization
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_POP_OS_HOST=http://192.168.93.99:11434
OLLAMA_DUAL_HOST_ROUTING_ENABLED=true
OLLAMA_MAX_CONCURRENT_TASKS=2
OLLAMA_USE_QWEN_FOR_EXTRACTION=true
OLLAMA_USE_PHI_FOR_FAST_SIMPLE=true
OLLAMA_USE_SECONDARY_FOR_EXTRACTION=true

# --- Pipeline operating schedule (US/Eastern) ---
PIPELINE_SCHEDULE_TZ=US/Eastern
PIPELINE_NIGHTLY_START_HOUR=0
PIPELINE_NIGHTLY_END_HOUR=7
PIPELINE_DAYTIME_START_HOUR=7
PIPELINE_DAYTIME_END_HOUR=16
PIPELINE_QUIET_ALLOWED_PHASES=health_check,pending_db_flush,vault_morning_prime,storyline_automation,entity_profile_build,story_continuation
PIPELINE_QUIET_HOURS_DISABLED=true
NIGHTLY_UNIFIED_PIPELINE_ENABLED=true
UNIFIED_INTAKE_EXTRACTION_ENABLED=true
NIGHTLY_PIPELINE_TZ=US/Eastern
NIGHTLY_PIPELINE_START_HOUR=0
NIGHTLY_PIPELINE_END_HOUR=7
NIGHTLY_ENRICHMENT_CONTEXT_START_HOUR=0
NIGHTLY_ENRICHMENT_CONTEXT_END_HOUR=7
NIGHTLY_PIPELINE_ALL_DAY=false

# --- Queue defaults (tunable via .env) ---
DB_POOL_WORKER_MAX=14
DB_POOL_UI_MAX=24
OLLAMA_EXTRACTION_NUM_CTX=8192
UNIFIED_INTAKE_EXTRACTION_PARALLEL=8
UNIFIED_INTAKE_EXTRACTION_BATCH_SIZE=2
UNIFIED_INTAKE_EXTRACTION_ARTICLES_PER_DOMAIN=80

# Event-core founding on assembly (quality-type megathreads)
EVENT_CORE_MEMBERSHIP_ENABLED=true

EPISODE_CONTAINER_ASSEMBLY_ENABLED=true
STORYLINE_AUTOMATION_AUTO_ATTACH=1
OLLAMA_MODEL_EXTRACTION=qwen3.6:latest
OLLAMA_EXTRACTION_NUM_PREDICT=6144

# Enabled for v11 modal drain after fulltext rebuild (2026-08-15)
FEATURE_STAGED_RUNTIME_ENABLED=true
EDITORIAL_NARRATIVE_ENABLED=true
EDITORIAL_REDUCTION_ENABLED=true
EDITORIAL_RESEARCH_ENABLED=true
EDITORIAL_COMPOSE_ENABLED=true
EDITORIAL_EVIDENCE_EXPAND_ENABLED=true
OLLAMA_MODEL_PRIMARY=llama3.1:8b
OLLAMA_MODEL_SECONDARY=mistral-nemo:12b
OLLAMA_MODEL_PHI=phi3.5:latest
OLLAMA_MODEL_EMBEDDING=nomic-embed-text
OLLAMA_NARRATIVE_FINISHER_MODEL=qwen3.6:latest
OLLAMA_OPTIONAL_QUALITY_MODEL=qwen3.6:latest
BULK_EXTRACTION_MODEL=qwen3.6:latest
DOSSIER_NARRATIVE_MODEL=qwen3.6:latest
OLLAMA_NARRATIVE_FINISHER_FALLBACK_TO_PRIMARY=false
FRED_API_KEY=b3f32699a5ef5ec70e2f6556c4696041
SANCTIONS_INGEST_ENABLED=true
EIA_API_KEY=DEMO_KEY
TRADE_RESOURCES_IMPORT_ENABLED=true
OPENWEBUI_MCPO_API_KEY=Homelab@MCPSERVER2026
MEMPALACE_HTTP_API_KEY=Homelab@MCPSERVER2026
MEMPALACE_HTTP_BASE=http://127.0.0.1:18443/mempalace
CLAIM_EVIDENCE_APPRAISAL_ENABLED=true
OLLAMA_CONCURRENCY=2
MAX_CONCURRENT_OLLAMA_TASKS=2
OLLAMA_GPU_CONCURRENCY=1
OLLAMA_CPU_CONCURRENCY=1
OLLAMA_EMBEDDINGS_HOST=http://127.0.0.1:11435
DB_POOL_HEALTH_MAX=2
