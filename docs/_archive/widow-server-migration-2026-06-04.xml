log "📍 Backup Location: $BACKUP_DIR"
log ""
log "📋 Files Created:"
ls -lh "$BACKUP_DIR"/*"$TIMESTAMP"* 2>/dev/null | awk '{print "   " $9 " (" $5 ")"}'
log ""
log "📄 Manifest: $BACKUP_DIR/MANIFEST-$TIMESTAMP.txt"
log ""
log "📝 Next Steps:"
