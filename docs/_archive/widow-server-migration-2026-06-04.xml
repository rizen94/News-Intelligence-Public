    id SERIAL PRIMARY KEY,
    article1_id INTEGER NOT NULL REFERENCES articles(id) ON DELETE CASCADE,
    article2_id INTEGER NOT NULL REFERENCES articles(id) ON DELETE CASCADE,
    similarity_score DECIMAL(4,3) NOT NULL,
