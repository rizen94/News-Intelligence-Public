fi
echo ""

# 5. Redis
echo -e "${CYAN}[5/7]${NC} Redis Service"
if docker ps --filter "name=redis" --format "{{.Names}}" 2>/dev/null | grep -q .; then
    echo -e "${GREEN}✅ Redis container running${NC}"
else
