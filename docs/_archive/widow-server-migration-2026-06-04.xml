CREATE TABLE IF NOT EXISTS timeline_event_sources (
    id SERIAL PRIMARY KEY,
    event_id VARCHAR(255) NOT NULL,
    article_id INTEGER NOT NULL,
    relevance_score NUMERIC(3,2) DEFAULT 0.0,
