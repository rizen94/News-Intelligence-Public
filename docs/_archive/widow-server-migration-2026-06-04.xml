    LOOP
        EXECUTE format('ANALYZE %I.articles', domain_schema);
        EXECUTE format('ANALYZE %I.storylines', domain_schema);
        EXECUTE format('ANALYZE %I.rss_feeds', domain_schema);
        RAISE NOTICE 'Analyzed tables for schema: %', domain_schema;
