    a.created_at,
    a.analysis_updated_at,
    CASE 
        WHEN a.analysis_updated_at IS NULL THEN 'pending'
        WHEN a.analysis_updated_at < a.created_at THEN 'outdated'
        ELSE 'analyzed'
    END as analysis_status,
    a.sentiment_score,
    a.sentiment_label,
    a.quality_score
FROM articles a;

