    impact_level VARCHAR(50) DEFAULT 'medium',  -- 'low', 'medium', 'high', 'critical'
    location VARCHAR(255),
    entities JSONB DEFAULT '[]'::jsonb,
    tags TEXT[] DEFAULT '{}',
    
    -- Verification and quality
