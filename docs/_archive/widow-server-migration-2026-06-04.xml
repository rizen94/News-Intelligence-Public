        SET article_count = article_count + 1,
            last_article_added = CURRENT_TIMESTAMP,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = NEW.storyline_id;
        RETURN NEW;
    ELSIF TG_OP = 'DELETE' THEN
        UPDATE storylines 
        SET article_count = article_count - 1,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = OLD.storyline_id;
        RETURN OLD;
    END IF;
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

