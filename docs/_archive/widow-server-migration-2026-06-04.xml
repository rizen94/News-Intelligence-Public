    WARNINGS=$((WARNINGS + 1))
fi
echo ""

# 6. Application Dependencies
echo -e "${CYAN}[6/7]${NC} Application Dependencies"
if [ -d "$PROJECT_DIR/api" ] && [ -f "$PROJECT_DIR/api/requirements.txt" ]; then
    echo -e "${GREEN}✅ API directory and requirements.txt found${NC}"
else
