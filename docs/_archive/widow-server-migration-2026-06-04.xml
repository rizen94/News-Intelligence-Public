-- ============================================================================
-- TEMPORAL EXPRESSIONS TABLE
-- ============================================================================

-- Store extracted temporal expressions for analysis and normalization
CREATE TABLE IF NOT EXISTS temporal_expressions (
    id SERIAL PRIMARY KEY,
