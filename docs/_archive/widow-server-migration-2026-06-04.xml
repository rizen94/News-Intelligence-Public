# Count files and directories
FILE_COUNT=$(tar -tzf "$BACKUP_DIR/$LATEST_BACKUP_NAME" | wc -l)
echo "📦 Total files/directories: $FILE_COUNT" >> "$BACKUP_DIR/MANIFEST-$TIMESTAMP.txt"
log "   📦 Total files/directories: $FILE_COUNT"

# Cleanup temp file
