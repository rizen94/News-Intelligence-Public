fi
echo ""

# 4. Database Connection
echo -e "${CYAN}[4/7]${NC} Database Connection Test"
if python3 << 'PYTHON_EOF'
import os
import sys
sys.path.insert(0, 'api')

os.environ['DB_HOST'] = 'localhost'
os.environ['DB_PORT'] = '5433'
