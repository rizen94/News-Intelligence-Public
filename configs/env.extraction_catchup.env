# Focused unlimited extraction catch-up (PopOS GPU + dual lane).
# Sourced by scripts/start_focused_extraction_catchup.sh — not for steady-state .env append.

BULK_CATCHUP_ACTIVE=1
AUTOMATION_BULK_CATCHUP_PAUSE=1
PIPELINE_BACKFILL_MODE=true

OLLAMA_DUAL_HOST_ROUTING_ENABLED=true
BULK_USE_POPOS_GPU=true
BULK_DUAL_LANE_CATCHUP=true
BULK_USE_POPOS_EXTRACTION=true
BULK_EXTRACTION_MODEL=llama3.1:8b
BULK_CPU_EXTRACTION_MODEL=llama3.1:8b
BULK_GPU_PARALLEL=8
BULK_CPU_PARALLEL=8
BULK_OLLAMA_TIMEOUT=900
OLLAMA_GPU_CONCURRENCY=8
OLLAMA_CPU_CONCURRENCY=8

UNIFIED_INTAKE_EXTRACTION_ENABLED=true
OLLAMA_EXTRACTION_NUM_PREDICT=4096
UNIFIED_INTAKE_EXTRACTION_BATCH_SIZE=3
UNIFIED_INTAKE_EXTRACTION_PARALLEL=8
UNIFIED_INTAKE_EXTRACTION_RUN_BUDGET_SECONDS=14400
OLLAMA_GPU_CONCURRENCY=8

ENTITY_EXTRACTION_BATCH_SIZE=6

EXTRACTION_BURN_DOWN_LOOPS=0
EXTRACTION_BURN_DOWN_FLOOR=0
EXTRACTION_BURN_DOWN_STALL_LOOPS=8

AUTOMATION_USE_POPOS_GPU=true
AUTOMATION_DUAL_LANE=true
AUTOMATION_FIXED_RESOURCE_POLICY=true
