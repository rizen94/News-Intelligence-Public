# Optional overlay for public HTTPS demo — copy to project root on Widow as:
#   /opt/news-intelligence/.env.public_demo
# systemd unit `news-intelligence-api-public.service` loads it AFTER `.env` and
# overrides duplicate keys — keep TRUSTED_HOSTS / CORS / DEMO_HOSTS in sync with
# your public URL (mismatch → TrustedHostMiddleware 400 "Invalid host header").
#
# Production (June 2026): https://news-intelligence-ag.duckdns.org

NEWS_INTEL_ENV=production
NEWS_INTEL_TRUSTED_HOSTS=news-intelligence-ag.duckdns.org,localhost,127.0.0.1
NEWS_INTEL_CORS_ORIGINS=https://news-intelligence-ag.duckdns.org

# Demo read-only (see api/shared/middleware/demo_readonly.py + web PublicDemoProvider).
# Disable to show full SPA (Monitor, watchlist, mutations) on the public hostname:
NEWS_INTEL_DEMO_READ_ONLY=false
# NEWS_INTEL_DEMO_HOSTS=news-intelligence-ag.duckdns.org
# NEWS_INTEL_DEMO_READ_ONLY_ALL=false
# NEWS_INTEL_DEMO_POST_ALLOWLIST=
#
# Re-enable demo: set NEWS_INTEL_DEMO_READ_ONLY=true and NEWS_INTEL_DEMO_HOSTS to your public hostname.

NEWS_INTEL_SQL_EXPLORER=false
# LOG_LLM_FULL_TEXT=false
