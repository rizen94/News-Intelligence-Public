# Widow API — thin orchestrator when PopOS phase worker owns heavy drains.
# Merge into /opt/news-intelligence/.env on Widow (do not set WORKER_EXECUTION_HOST here).

REMOTE_PHASE_WORKER_ENABLED=true
REMOTE_PHASE_WORKER_OWNED_PHASES=unified_intake_extraction,claim_extraction,topic_clustering,storyline_assembly,editorial_research_pass,editorial_narrative_pass,editorial_reduction_pass,chronological_events_catchup

# Widow keeps light local work; LLM/assembly drains on PopOS worker.
AUTOMATION_MAX_CONCURRENT_TASKS=2
MAX_CONCURRENT_OLLAMA_TASKS=2
AUTOMATION_RSS_PAUSE_MB=1800
# PDF extract heaps must not share the UI process until a sidecar exists:
AUTOMATION_BLOCK_PHASES=document_processing
FINANCE_USE_SENTENCE_TRANSFORMERS=false
DOCUMENT_PROCESSING_RSS_ABORT_MB=1800

# More headroom for API / Monitor DB once heavy phases are off-box:
DB_POOL_UI_MIN=2
DB_POOL_UI_MAX=12
DB_POOL_WORKER_MIN=2
DB_POOL_WORKER_MAX=12
