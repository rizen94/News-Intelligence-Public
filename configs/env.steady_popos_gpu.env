# Steady-state Widow → PopOS GPU routing (merge into /opt/news-intelligence/.env on Widow prod).
# CPU/light work stays on Widow local Ollama; GPU-heavy phases use PopOS RTX 5090 via :11434 proxy.
#
# Models on PopOS must exist (`curl http://192.168.93.99:11434/api/tags`). Extraction uses 32b, not 7b.

OLLAMA_HOST=http://localhost:11434
OLLAMA_CPU_HOST=http://localhost:11434
OLLAMA_POP_OS_HOST=http://192.168.93.99:11434
OLLAMA_GPU_HOST=http://192.168.93.99:11434
OLLAMA_DUAL_HOST_ROUTING_ENABLED=true

OLLAMA_MODEL_EXTRACTION=qwen2.5:32b-instruct
OLLAMA_MODEL_PRIMARY=llama3.1:8b
OLLAMA_MODEL_SECONDARY=llama3.1:8b

AUTOMATION_USE_POPOS_GPU=true
AUTOMATION_DUAL_LANE=true

# Tune with MAX_CONCURRENT_OLLAMA_TASKS / GPU VRAM on PopOS
OLLAMA_GPU_CONCURRENCY=3
OLLAMA_CPU_CONCURRENCY=3
