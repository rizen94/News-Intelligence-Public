# PopOS phase worker — copy to /opt/news-intelligence/.env.popos_worker on PopOS
# (or project .env.popos_worker). Do not commit real DB_PASSWORD.
# Homelab postgres-mcp stays read-only; this is newsapp write.

DB_HOST=192.168.93.101
DB_PORT=6432
DB_NAME=news_intel
DB_USER=newsapp
# DB_PASSWORD=...

WORKER_EXECUTION_HOST=popos
# Split workers pass --phases on the CLI (preferred). This CSV is only used for --monolith
# or when --phases is omitted. Installer default: uie | claim+topic | assembly units.
WORKER_PHASES=unified_intake_extraction,chronological_events_catchup,claim_extraction,topic_clustering,storyline_assembly,editorial_research_pass,editorial_narrative_pass,editorial_reduction_pass

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DUAL_HOST_ROUTING_ENABLED=false
AUTOMATION_DUAL_LANE=false
BULK_DUAL_LANE_CATCHUP=false

# Prefer PopOS-scale UIE knobs here (not on Widow API):
UNIFIED_INTAKE_EXTRACTION_PARALLEL=6
UNIFIED_INTAKE_EXTRACTION_BATCH_SIZE=6
UNIFIED_INTAKE_EXTRACTION_ARTICLES_PER_DOMAIN=60

DB_POOL_WORKER_MIN=2
DB_POOL_WORKER_MAX=12
DB_POOL_UI_MIN=1
DB_POOL_UI_MAX=4
