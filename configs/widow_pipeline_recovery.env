# Widow steady-state pipeline recovery (Jun 2026).
# Append to /opt/news-intelligence/.env then restart news-intelligence-api-public.

# Unified intake: 1h drain budget per automation task (was 900s default).
UNIFIED_INTAKE_EXTRACTION_RUN_BUDGET_SECONDS=3600

# Allow refinement phases while bulk intake backlog is high.
ENTITY_PROFILE_BUILD_ANYTIME=true
PIPELINE_REFINEMENT_ANYTIME=true
