{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "showLineNumbers": true,
    "compress": true,
    "topFilesLength": 10
  },
  "include": [
    "**/*.py",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.sh",
    "**/*.sql",
    "**/Dockerfile",
    "docker-compose*.yml",
    "requirements*.txt",
    "pyproject.toml",
    "README.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "docs/archive/**",
      "docs/_archive/**",
      "diagnostics/**",
      "scripts/archive/**",
      "scripts/ni_review/**",
      "api/database/migrations/archive/**",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/venv/**",
      "**/node_modules/**",
      "*.jsonl",
      "*.log",
      "*.bak*",
      ".env*",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
