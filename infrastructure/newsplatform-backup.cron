# News Intelligence — Database backup on Widow (homelab: single rolling file on NAS)
# One daily run; no stacked dated dumps. Log archive runs on primary.
# Paths substituted by setup_widow_app.sh / setup_widow_boot_stack.sh
#
# Output: /mnt/nas/Data Lake Storage/news-intelligence/database-backup/news_intel_latest.pgdump
# (override BACKUP_BASE if the NAS mount differs on this host.)
#
# IMPORTANT: cron.d files MUST end with a newline or cron ignores the whole file
# ("Missing newline before EOF, this crontab file will be ignored").

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# 03:45 — mid-heavy; stack settled; script defers if USB disk IO governor says heavy
45 3 * * * pete /opt/news-intelligence/scripts/db_backup_single_latest.sh >> /opt/news-intelligence/logs/backup.log 2>&1

# 12:00 — alert if NAS rolling dump older than 36h (catches ignored cron / failed runs)
0 12 * * * pete /opt/news-intelligence/scripts/db_backup_age_alert.sh >> /opt/news-intelligence/logs/backup_age_alert.log 2>&1
